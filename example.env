# Safe local-development defaults. `npm run dev` supplies these values itself.
GAME_ENV=dev
NUM_WORKERS=2
DOMAIN=localhost
GIT_COMMIT=DEV
TURNSTILE_SITE_KEY=1x00000000000000000000AA
API_KEY=WARNING_DEV_API_KEY_DO_NOT_USE_IN_PRODUCTION
ADMIN_BOT_API_KEY=WARNING_DEV_ADMIN_BOT_KEY_DO_NOT_USE_IN_PRODUCTION

# Keep API calls local. Leave API_DOMAIN empty unless operating your own API.
API_DOMAIN=

# OpenFront-specific browser analytics, advertising, and platform SDK scripts
# are legacy-only and disabled by default. Reusable Turnstile bot protection
# remains enabled with the published localhost test key above.
ENABLE_LEGACY_OPENFRONT_INTEGRATIONS=false

# Optional same-project CDN. Leave empty to serve assets from this app.
CDN_BASE=

# OpenTelemetry is disabled when either value is empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_AUTH_HEADER=

# Private match telemetry is disabled by default.
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32
